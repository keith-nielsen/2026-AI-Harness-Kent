# =============================================================================
# Kent — Gent Fractal Stack Container
# Base image for all Gent CEO + CrewAI worker stacks.
# Built once, spawned many times with per-stack secrets and config.
# =============================================================================
FROM python:3.12-slim

LABEL maintainer="Keith Nielsen"
LABEL description="Kent fractal Gent stack — CEO agent + CrewAI workers"

# Non-root prep
RUN groupadd -r gent && useradd -r -g gent -d /app -s /usr/sbin/nologin gent

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl jq git sqlite3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

# Application code
WORKDIR /app
COPY app/ /app/

# Data volume (stack.db lives here, bind-mounted at runtime)
VOLUME ["/data"]

# Secrets arrive at /run/secrets/ via Docker secrets
# Config arrives via environment variables (non-secret only)

# Run as non-root
USER gent

# Health check: CEO heartbeat
HEALTHCHECK --interval=60s --timeout=5s --retries=3 \
    CMD python -c "import sqlite3; c=sqlite3.connect('/data/stack.db'); c.execute('SELECT 1'); print('ok')"

ENTRYPOINT ["python", "-m", "gent.main"]
