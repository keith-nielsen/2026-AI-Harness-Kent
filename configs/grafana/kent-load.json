{
  "uid": "kent-load",
  "title": "Kent load",
  "tags": [
    "kent"
  ],
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "timezone": "browser",
  "editable": true,
  "description": "Host load while Kent and its Gents work: CPU and GPU temperature and busy %, next to the model calls by caller and tier.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU and GPU temperature",
      "description": "CPU: k10temp sensors (Tctl = control temperature, Tccd = core die). GPU: nvidia-smi every 15 s (bold red).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kent-prometheus"
          },
          "expr": "node_hwmon_temp_celsius{chip=\"pci0000:00_0000:00:18_3\"} * on(chip, sensor) group_left(label) node_hwmon_sensor_label",
          "legendFormat": "CPU {{label}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kent-prometheus"
          },
          "expr": "kent_gpu_temperature_celsius",
          "legendFormat": "GPU {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 4
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Model calls by caller and tier",
      "description": "Gateway calls per interval: auto calls under the tier the router chose, others under the model group asked for.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "kent-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "kent-loki"
          },
          "expr": "sum by (identity, tier) (count_over_time({kent_event=\"llm_call\"} | json | model_group!=\"\" | label_format tier=`{{ if .routed_tier }}{{ .routed_tier }}{{ else }}{{ .model_group }}{{ end }}` [$__auto]))",
          "legendFormat": "{{identity}} {{tier}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU and GPU busy",
      "description": "CPU: all cores, 1-minute rate. GPU: nvidia-smi utilisation (bold red).",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kent-prometheus"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "CPU busy"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kent-prometheus"
          },
          "expr": "100 * kent_gpu_utilization_ratio",
          "legendFormat": "GPU busy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 4
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPU power and memory",
      "description": "From nvidia-smi every 15 s.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kent-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kent-prometheus"
          },
          "expr": "kent_gpu_power_watts",
          "legendFormat": "power (W)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kent-prometheus"
          },
          "expr": "100 * kent_gpu_memory_used_bytes / kent_gpu_memory_total_bytes",
          "legendFormat": "memory used (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
