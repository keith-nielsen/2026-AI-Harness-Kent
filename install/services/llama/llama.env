# /etc/kent/llama/llama.env — settings for kent-llama.service (the local model server).
# Change with: sudo ./kent-admin llama set KEY=VALUE   (then: kent llama restart)
# Defaults are the operator's measured optimum (see install/services/llama/bin/kent_llama_launch.py).
MODEL_SET=mtp
CTX=256k
UB=
NCMOE=
THINK=0
ALIAS=locally-run-model
PIN=0
CORES=2,4,5,6,7
FORCE_256K=0
TUNE=1
