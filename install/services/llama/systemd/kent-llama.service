# /etc/systemd/system/kent-llama.service
# Local model server (llama.cpp llama-server) for the Kent gateway's local tiers, on 127.0.0.1:8080.
# Installed by install/services/llama/install.sh. On demand, not at boot: members of
# kent-operators start and stop it with `kent llama start|stop` (polkit rule 60-kent-llama.rules).
#
# Runs as kent-llama (system account, no login, no sudo). Reads the models only through the
# read-only bind mount /srv/kent/models, as a member of kent-models, and only after their SHA-256
# matches the install-time record. Settings in /etc/kent/llama/llama.env.

[Unit]
Description=Kent local model server (llama.cpp)
Requires=srv-kent-models.mount kent-llama-tuning.service
After=srv-kent-models.mount kent-llama-tuning.service

[Service]
Type=simple
User=kent-llama
Group=kent-llama
SupplementaryGroups=kent-models
EnvironmentFile=/etc/kent/llama/llama.env
# Libraries ship next to the binary; the build's RUNPATH (a home directory) is unreachable here.
Environment=LD_LIBRARY_PATH=/opt/kent-llama/lib
Environment=HOME=/var/cache/kent-llama
Environment=CUDA_CACHE_PATH=/var/cache/kent-llama/cuda
CacheDirectory=kent-llama
CacheDirectoryMode=0700
WorkingDirectory=/var/cache/kent-llama
ExecStartPre=/opt/kent-llama/libexec/kent-llama-verify
ExecStart=/opt/kent-llama/libexec/kent-llama-launch
ExecStartPost=/opt/kent-llama/libexec/kent-llama-wait
# Hash check (~24 GB) + load with --no-mmap (~21 GiB read into RAM) + warm-up.
TimeoutStartSec=900
TimeoutStopSec=30
Restart=on-failure
RestartSec=10
Nice=5

# --- Hardening ---
# The GPU needs its NVIDIA device nodes, so no PrivateDevices; instead only those are allowed.
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
# Not MemoryDenyWriteExecute (CUDA may JIT kernels) nor ProcSubset=pid (the driver reads /proc/driver/nvidia).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
NoExecPaths=/srv/kent/models
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
