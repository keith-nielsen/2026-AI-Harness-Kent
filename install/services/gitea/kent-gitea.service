# /etc/systemd/system/kent-gitea.service — installed by install/services/gitea
[Unit]
Description=Gitea git service (Kent)
Documentation=https://docs.gitea.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gitea
Group=gitea
Environment=HOME=/var/lib/gitea GITEA_WORK_DIR=/var/lib/gitea USER=gitea
ExecStart=/opt/kent-gitea/gitea web --config /etc/kent/gitea/app.ini --work-path /var/lib/gitea
StateDirectory=gitea
StateDirectoryMode=0750
WorkingDirectory=/var/lib/gitea
Restart=on-failure
RestartSec=5

# --- Hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027

[Install]
WantedBy=multi-user.target
