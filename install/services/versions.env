# Hermes Agent for Kent's own install (release tag, peeled commit, hash of its uv.lock).
# Installed editable from a root-owned checkout (Hermes refuses non-editable builds) into a
# venv built by a pinned uv from the lock, against the system Python (release supports 3.11-3.13).
HERMES_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_TAG=v2026.9.24
HERMES_COMMIT=f97608f178d1ffeca59860195ab7da295f7c8e5f
HERMES_UVLOCK_SHA256=5b3798f326209475abca8ef7cbf7c9406f12e687c28c0b540dfe597466f48590

# uv (Astral), standalone binary used only to build Kent's Hermes venv from uv.lock.
UV_VERSION=0.11.23
UV_URL=https://github.com/astral-sh/uv/releases/download/0.11.23/uv-x86_64-unknown-linux-gnu.tar.gz
UV_SHA256=e12c4cda2fe8c305510a78380a88f2c32a27e90cdcd123cefd2873388f0ebb5f

# tirith (sheeki03/tirith, AGPL-3.0): Hermes' pre-exec command scanner, installed root-owned for
# Kent's Hermes so Hermes never auto-downloads an unpinned "latest". SHA-256 of the release
# archive; checksums.txt is cosign-signed by the project's release workflow (verified for 0.4.2).
TIRITH_VERSION=0.4.2
TIRITH_URL=https://github.com/sheeki03/tirith/releases/download/v0.4.2/tirith-x86_64-unknown-linux-gnu.tar.gz
TIRITH_SHA256=efa6bf414a83dba385d4f13137e8677f850ced9102fe74ebb14c72f31df0dc77

# SearXNG (metasearch; Kent's web search and the Gents' structured search API) — image pinned by digest.
SEARXNG_IMAGE=searxng/searxng@sha256:02aa607ecc87165ebe6212476a176b8984d891c01a2d130ad03a58109d13db77
