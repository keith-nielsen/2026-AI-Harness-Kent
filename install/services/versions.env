# Kent — pinned third-party artifacts for install/services modules.
# Each hash is the upstream-published SHA-256, fetched and recorded 2026-09-27.
# Installers verify downloads against THESE values (not a checksum file fetched
# at install time). To upgrade: change version + URL + hash together, in one commit.

# Prometheus — https://github.com/prometheus/prometheus/releases (sha256sums.txt)
PROMETHEUS_VERSION=3.15.0
PROMETHEUS_URL=https://github.com/prometheus/prometheus/releases/download/v3.15.0/prometheus-3.15.0.linux-amd64.tar.gz
PROMETHEUS_SHA256=2a542df32eac02ee17b9d844fb2aa1de00dafa5476579ba8a3ba862e9d572ea0

# node_exporter — https://github.com/prometheus/node_exporter/releases (sha256sums.txt)
NODE_EXPORTER_VERSION=1.12.1
NODE_EXPORTER_URL=https://github.com/prometheus/node_exporter/releases/download/v1.12.1/node_exporter-1.12.1.linux-amd64.tar.gz
NODE_EXPORTER_SHA256=b51d8a76aa2a9156a55d501aca6276fae09e262259a5e4e831d2c2222f084e63

# Loki — https://github.com/grafana/loki/releases (SHA256SUMS)
LOKI_VERSION=3.7.8
LOKI_URL=https://github.com/grafana/loki/releases/download/v3.7.8/loki-linux-amd64.zip
LOKI_SHA256=62aea42c9cba52cd1642b3666ab37019a0ce4c24ab50b07e85dccc8d812f7d61

# Gitea — https://github.com/go-gitea/gitea/releases
# Hash taken from gitea-1.27.3-linux-amd64.sha256, whose detached signature (.asc)
# verified GOODSIG against Gitea's release key
# 7C9E68152594688862D62AF62D9AE806EC1592E2 (signing subkey 5FC346329753F4B0, "Teabot").
GITEA_VERSION=1.27.3
GITEA_URL=https://github.com/go-gitea/gitea/releases/download/v1.27.3/gitea-1.27.3-linux-amd64
GITEA_SHA256=4da93c2c10b6980c359bcb86d5573ebfd7770e2e151756534edee24c8c12d971

# Hermes Agent for Kent's own install (release tag, peeled commit, hash of its uv.lock).
# Installed editable from a root-owned checkout (Hermes refuses non-editable builds) into a
# venv built by a pinned uv from the lock. Since v0.21.6 the lock covers Python 3.14 only
# (pyproject [tool.uv] environments), so the venv runs on the pinned Python below, not the system's.
HERMES_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_TAG=v0.21.7
HERMES_COMMIT=71d34bad1045610252eda02ee79549436896e784
HERMES_UVLOCK_SHA256=95a3082629ffecdabb1bad0880ccf5a237d47cd8fb67d86094f6d3d331f4eeac

# CPython for Kent's Hermes only (astral-sh/python-build-standalone, the build uv itself installs),
# unpacked root-owned into /opt/kent-hermes/python. SHA-256 matches the release's SHA256SUMS.
HERMES_PYTHON_VERSION=3.14.6
HERMES_PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260610/cpython-3.14.6%2B20260610-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
HERMES_PYTHON_SHA256=0881fbde2c78605720fb2e240d1a6df38652a896e40a5fce2e10908dbee5f5b7

# uv (Astral), standalone binary used only to build Kent's Hermes venv from uv.lock.
UV_VERSION=0.11.23
UV_URL=https://github.com/astral-sh/uv/releases/download/0.11.23/uv-x86_64-unknown-linux-gnu.tar.gz
UV_SHA256=e12c4cda2fe8c305510a78380a88f2c32a27e90cdcd123cefd2873388f0ebb5f

# SearXNG (metasearch; Kent's web search and the Gents' structured search API) — image pinned by digest.
SEARXNG_IMAGE=searxng/searxng@sha256:02aa607ecc87165ebe6212476a176b8984d891c01a2d130ad03a58109d13db77
SEARXNG_VERSION=2026.7.7-f69b22c45

# Grafana and Alloy — vendor .deb packages from https://apt.grafana.com, installed from the pinned
# file (no apt source is added, so system updates cannot move them). Each hash matches the SHA256
# of that version in the repository's signed Packages index (Release key B53AE77BADB630A683046005963FA27710458545,
# "Grafana Labs"), checked 2026-09-29; these are the versions the integration install ran with.
# Grafana's plugins are the copies inside this package (13.2.2 bundles prometheus 13.1.7, loki 13.2.0);
# its own plugin downloads and updates are turned off (grafana/kent.conf), so they move only with the .deb.
GRAFANA_VERSION=13.2.2
GRAFANA_DEB_URL=https://apt.grafana.com/pool/main/g/grafana/grafana_13.2.2_34846740809_linux_amd64.deb
GRAFANA_DEB_SHA256=ffbce0e8c097e778c5f7881a248ce82aa05c2de03f7a95881c70add472ba1e57
ALLOY_VERSION=1.20.0-1
ALLOY_DEB_URL=https://apt.grafana.com/pool/main/a/alloy/alloy-1.20.0-1.amd64.deb
ALLOY_DEB_SHA256=c0994473ef41498ac37392baef22081d6b7f6c4d45632600e93d202a3c34d661
