# Kent — pinned third-party artifacts for install/services modules.
# Each hash is the upstream-published SHA-256, fetched and recorded 2026-09-27.
# Installers verify downloads against THESE values (not a checksum file fetched
# at install time). To upgrade: change version + URL + hash together, in one commit.

# Prometheus — https://github.com/prometheus/prometheus/releases (sha256sums.txt)
PROMETHEUS_VERSION=3.15.0
PROMETHEUS_URL=https://github.com/prometheus/prometheus/releases/download/v3.15.0/prometheus-3.15.0.linux-amd64.tar.gz
PROMETHEUS_SHA256=2a542df32eac02ee17b9d844fb2aa1de00dafa5476579ba8a3ba862e9d572ea0

