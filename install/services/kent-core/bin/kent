#!/usr/bin/python3 -I
"""kent — work with Kent as yourself (members of group kent-operators).

  kent                          chat with Kent
  kent -q "question"            one question, one answer
  kent [--grant DIR | --grant-rw DIR]... [-q "question"]
                                give Kent (chat or one question) a folder you own, read-only or
                                read-write, even inside your home; without a grant Kent cannot
                                see your files. Inside it, normal permissions apply: Kent reads
                                what is readable by others and writes only where kent may write
  kent status                   health of Kent and its services
  kent digest                   today's digest
  kent notices [--all]          what Kent has to tell you about Gents (finished, failed, halted, stuck)
  kent audit                    verify Kent's audit chain
  kent gents                    list Gents
  kent gent <status|logs|wait|assess|pause|resume|restart|destroy> ID [...]
  kent gent export ID [DEST]    copy a Gent's deliverables into DEST (default ./gent-ID), owned by you
  kent new DIR [--name NAME]    start a Gent from DIR/project.yaml, agents.yaml, tasks.yaml
  kent llama <start|stop|restart|status>   the local model server (on demand)

Kent runs under its own account; this command talks to it through one fixed, audited entry
point (sudo -u kent kent-exec). Kent runs in a sandbox: it sees only the folders you grant.
`kent llama` goes to systemd directly (polkit lets kent-operators start/stop that one unit).
"""
import fcntl
import grp
import io
import json
import os
import pwd
import subprocess
import sys
import tarfile
import urllib.request
from pathlib import Path

EXEC = "/opt/kent-core/libexec/kent-exec"
LLAMA_UNIT = "kent-llama.service"
LLAMA_SOURCE = "/opt/kent-llama/libexec/kent-llama-source"
PROJECT_FILES = ("project.yaml", "agents.yaml", "tasks.yaml")
MAX_FILE = 256 * 1024


def die(msg: str, code: int = 1) -> None:
    print(f"kent: {msg}", file=sys.stderr)
    sys.exit(code)


def check_group() -> None:
    try:
        gid = grp.getgrnam("kent-operators").gr_gid
    except KeyError:
        die("Kent is not installed (group kent-operators missing)")
    if gid in os.getgroups() or os.geteuid() == 0:
        return
    user = os.environ.get("USER") or os.getlogin()
    if user in grp.getgrnam("kent-operators").gr_mem:
        die("you were added to kent-operators, but this login session predates it.\n"
            "      Log out and back in, or run: newgrp kent-operators")
    die("you are not a Kent operator. An administrator can add you with: sudo kent-admin add-operator " + user)


def sudo_kent(fds: tuple[int, ...] = ()) -> list[str]:
    """sudo as kent; with grant descriptors, keep them open across sudo (sudoers closefrom_override)."""
    return ["sudo", "-n", *(["-C", str(max(fds) + 1)] if fds else []), "-u", "kent", EXEC]


def kexec(*args: str, stdin=None, stdout=None, fds: tuple[int, ...] = ()) -> int:
    return subprocess.run([*sudo_kent(fds), *args], input=stdin, stdout=stdout, pass_fds=fds).returncode


def pack_project(src: Path) -> bytes:
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        for name in PROJECT_FILES:
            p = src / name
            if not p.is_file() or p.is_symlink():
                die(f"{p} missing (need {', '.join(PROJECT_FILES)})")
            data = p.read_bytes()
            if len(data) > MAX_FILE:
                die(f"{p} is larger than {MAX_FILE} bytes")
            info = tarfile.TarInfo(name)
            info.size, info.mode = len(data), 0o640
            tar.addfile(info, io.BytesIO(data))
    return buf.getvalue()


def export(sid: str, dest: Path) -> int:
    r = subprocess.run(["sudo", "-n", "-u", "kent", EXEC, "export", sid], capture_output=True)
    if r.returncode != 0:
        sys.stderr.write(r.stderr.decode(errors="replace"))
        return r.returncode
    dest.mkdir(parents=True, exist_ok=True)
    with tarfile.open(fileobj=io.BytesIO(r.stdout), mode="r:gz") as tar:
        tar.extractall(dest, filter="data")          # no absolute paths, links or special files
    print(f"exported gent {sid} to {dest}")
    return 0


def llama(action: str) -> int:
    """Start/stop the local model server as yourself: no sudo, the polkit rule authorises it."""
    if action == "status":
        state = subprocess.run(["systemctl", "is-active", LLAMA_UNIT], capture_output=True, text=True).stdout.strip()
        model = ""
        try:
            with urllib.request.urlopen("http://127.0.0.1:8080/v1/models", timeout=5) as r:
                model = json.load(r)["data"][0]["id"]
        except Exception:  # noqa: BLE001 - not serving is a normal state here
            pass
        print(f"local model server: {state or 'unknown'}" + (f", serving '{model}' on 127.0.0.1:8080" if model else ""))
        return 0 if state == "active" else 3
    if action not in ("start", "stop", "restart"):
        die("usage: kent llama <start|stop|restart|status>", 2)
    user = pwd.getpwuid(os.getuid()).pw_name   # the real caller, not $USER
    subprocess.run(["logger", "-t", "kent-llama", "--", f"human:{user} {action}"], check=False)
    if action != "stop":
        print("verifying model hashes and loading the model (about 1-2 minutes)...", flush=True)
    rc = subprocess.run(["systemctl", "--no-ask-password", action, LLAMA_UNIT]).returncode
    if rc != 0:
        if action != "stop":   # the usual cause is the models drive: name it (moved, missing, not mounted)
            d = subprocess.run([LLAMA_SOURCE, "diagnose"], capture_output=True, text=True) \
                if os.access(LLAMA_SOURCE, os.X_OK) else None
            if d is not None and d.returncode == 1 and d.stdout.strip():
                print(f"kent: {d.stdout.strip()}", file=sys.stderr)
        die(f"{action} failed; see: journalctl -u {LLAMA_UNIT} -n 50", rc)
    return llama("status") if action != "stop" else 0


def take_grants(argv: list[str]) -> tuple[list[str], tuple[int, ...], list[str]]:
    """Leading --grant/--grant-rw DIR pairs. Each folder is opened here, as you, and handed to Kent
    as an open descriptor (fd 3 upward), so Kent needs no access to the path leading to it (your
    home, say); kent-exec checks the rest. Returns (kent-exec options, descriptors, rest)."""
    pairs = []
    while argv[:1] in (["--grant"], ["--grant-rw"]):
        if len(argv) < 2:
            die(f"{argv[0]} needs a directory", 2)
        d = Path(argv[1]).expanduser().resolve()
        try:
            pairs.append((argv[0], os.open(d, os.O_PATH | os.O_DIRECTORY)))
        except OSError as e:
            die(f"{argv[1]}: {e.strerror.lower()}", 2)
        argv = argv[2:]
    if len(pairs) > 8:
        die("at most 8 grants", 2)
    high = []
    for flag, fd in pairs:                       # out of the way of 3.. first, then into place
        high.append((flag, fcntl.fcntl(fd, fcntl.F_DUPFD, 100)))
        os.close(fd)
    out, fds = [], []
    for i, (flag, h) in enumerate(high):
        os.dup2(h, 3 + i)
        os.close(h)
        out += [flag, str(3 + i)]
        fds.append(3 + i)
    return out, tuple(fds), argv


def main(argv: list[str]) -> int:
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip()); return 0
    check_group()
    grants, fds, argv = take_grants(argv)
    if not argv:
        kexec("notices", "--quiet")   # unread notices first: Kent cannot speak until you do
        os.execvp("sudo", [*sudo_kent(fds), "chat", *grants])
    cmd = argv[0]
    if cmd == "-q":
        if len(argv) < 2:
            die('usage: kent [--grant DIR]... -q "question"', 2)
        return kexec("ask", *grants, stdin=" ".join(argv[1:]).encode(), fds=fds)
    if grants:
        die("--grant/--grant-rw go with chat (kent) or a question (kent -q)", 2)
    if cmd in ("status", "digest", "audit", "gents"):
        return kexec(cmd)
    if cmd == "notices":
        return kexec("notices", *argv[1:])
    if cmd == "new":
        if len(argv) < 2:
            die("usage: kent new DIR [--name NAME]", 2)
        src = Path(argv[1]).expanduser().resolve()
        name = argv[argv.index("--name") + 1] if "--name" in argv else src.name
        return kexec("new", "--name", name, stdin=pack_project(src))
    if cmd == "llama":
        return llama(argv[1] if len(argv) > 1 else "status")
    if cmd == "gent":
        if len(argv) < 3:
            die("usage: kent gent <action> ID [...]", 2)
        if argv[1] == "export":
            dest = Path(argv[3]).expanduser() if len(argv) > 3 else Path.cwd() / f"gent-{argv[2]}"
            return export(argv[2], dest)
        return kexec("gent", *argv[1:])
    die(f"unknown command {cmd!r} (see: kent --help)", 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
