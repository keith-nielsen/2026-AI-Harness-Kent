#!/usr/bin/python3 -I
"""kent-exec — Kent's side of the `kent` command. Runs as the kent account, reached only via
`sudo -u kent` by members of kent-operators (/etc/sudoers.d/92-kent-operators). Every argument
is validated here; every call is recorded in the audit chain with the calling human."""
import io
import json
import os
import re
import secrets
import subprocess
import sys
import tarfile
import time
from pathlib import Path

BIN = Path("/opt/kent-core/bin")
HERMES = "/opt/kent-hermes/bin/kent-hermes"
KHOME = Path("/var/lib/kent")
PY = "/usr/bin/python3"
GENT_ACTIONS = {"status": 0, "logs": 1, "wait": 1, "assess": 0, "pause": 0, "resume": 0, "restart": 0, "destroy": 1}
PROJECT_FILES = {"project.yaml", "agents.yaml", "tasks.yaml"}
# Folders an operator may not hand to Kent's sandbox (docs/design/kent-sandbox.md §5).
GRANT_FORBIDDEN = ("/etc", "/opt", "/usr", "/boot", "/root", "/run", "/proc", "/sys", "/dev",
                   "/var/lib/kent", "/var/lib/kent-gent")
MAX_GRANTS = 8
GRANT_FDS = range(3, 11)   # descriptors the kent command hands over (sudo -C keeps them open)
os.environ.update({"KENT_CONF": "/etc/kent/kent/kent.conf", "HOME": str(KHOME), "LANG": "C.UTF-8",
                   "PATH": "/opt/kent-core/bin:/usr/bin:/bin"})
sys.path.insert(0, str(BIN))
import kentlib  # noqa: E402


def die(msg: str, code: int = 1) -> None:
    print(f"kent: {msg}", file=sys.stderr)
    sys.exit(code)


def principal() -> str:
    p = os.environ.get("SUDO_USER", "")
    return p if re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", p) else "unknown"


def audit(event: str, detail: str = "") -> None:
    try:
        kentlib.audit(f"human:{principal()}", event, detail)
    except Exception as e:  # noqa: BLE001 - the action is refused if it cannot be audited
        die(f"audit chain unavailable ({e}); refusing to act")


def tool(name: str, *args: str) -> int:
    return subprocess.run([PY, str(BIN / name), *args]).returncode


def sid_ok(s: str) -> str:
    if not re.fullmatch(r"[0-9a-f]{8}", s):
        die("Gent id must be 8 hex characters", 2)
    return s


def take_grants(args: list[str]) -> tuple[list[str], list[str]]:
    """Leading --grant FD / --grant-rw FD pairs: folders the `kent` command opened as the operator
    and handed over as descriptors 3-10. Each must be a directory the calling operator owns whose
    real path is outside the system and Kent's own trees and is not a whole home; each is audited.
    → (kent-hermes options: flag, descriptor, path inside the sandbox; remaining args)."""
    import pwd
    import stat
    out: list[str] = []
    seen: set[int] = set()
    while args[:1] in (["--grant"], ["--grant-rw"]):
        if len(args) < 2 or not args[1].isdigit() or int(args[1]) not in GRANT_FDS or int(args[1]) in seen:
            die(f"{args[0]} takes a descriptor from the kent command (3-10, each once)", 2)
        flag, fd, args = args[0], int(args[1]), args[2:]
        seen.add(fd)
        try:
            st = os.fstat(fd)
            path = os.readlink(f"/proc/self/fd/{fd}")
        except OSError:
            die(f"grant: descriptor {fd} is not open (use the kent command)", 2)
        if not stat.S_ISDIR(st.st_mode) or not path.startswith("/") or path.endswith(" (deleted)"):
            die(f"grant {path}: not a directory", 2)
        if path == "/" or path == "/home" or any(path == f or path.startswith(f + "/") for f in GRANT_FORBIDDEN) \
                or path in {p.pw_dir for p in pwd.getpwall()}:
            die(f"grant {path}: not a folder Kent may be given (system, Kent's own, or a whole home directory)", 2)
        try:
            owner = pwd.getpwnam(principal()).pw_uid
        except KeyError:
            die("cannot tell who is calling; grants refused")
        if st.st_uid != owner:
            die(f"grant {path}: you can only grant folders you own", 2)
        need = os.R_OK | os.X_OK | (os.W_OK if flag == "--grant-rw" else 0)
        if not os.access(f"/proc/self/fd/{fd}", need):
            die(f"grant {path}: the kent account cannot {'write' if flag == '--grant-rw' else 'read'} this "
                "folder itself (make it readable by others, or by a group kent is in)", 2)
        out += [flag, str(fd), path]
    if len(out) > 3 * MAX_GRANTS:
        die(f"at most {MAX_GRANTS} grants", 2)
    for flag, path in zip(out[::3], out[2::3]):
        audit("grant", f"{'rw' if flag == '--grant-rw' else 'ro'} {path}")
    return out, args


def grant_fds(grants: list[str]) -> tuple[int, ...]:
    return tuple(int(fd) for fd in grants[1::3])


def close_other_fds(keep: tuple[int, ...]) -> None:
    """Before Hermes starts: nothing the caller left open reaches it except the grants."""
    for name in os.listdir("/proc/self/fd"):
        fd = int(name)
        if fd > 2 and fd not in keep:
            try:
                os.close(fd)
            except OSError:
                pass


def cmd_status() -> int:
    c = kentlib.conf()
    profile = Path("/etc/kent/profile").read_text().strip() if Path("/etc/kent/profile").exists() else "?"
    print(f"Kent — profile: {profile}   operator: {principal()}")
    units = ["kent-litellm", "kent-prometheus", "kent-node-exporter", "kent-loki", "alloy", "grafana-server",
             "kent-gitea", "kent-squid", "kent-searxng"]
    states = {u: subprocess.run(["systemctl", "is-active", u], capture_output=True, text=True).stdout.strip() for u in units}
    print("services: " + "  ".join(f"{u.replace('kent-', '')}={'ok' if s == 'active' else s}" for u, s in states.items()))
    kent_timers = ["kent-poll-learnings", "kent-audit-ingest", "kent-digest", "kent-qa-audit", "kent-audit-anchor"]
    armed = sum(1 for t in kent_timers if any(ch.isdigit() for ch in subprocess.run(
        ["systemctl", "show", f"{t}.timer", "-p", "NextElapseUSecRealtime", "--value"],
        capture_output=True, text=True).stdout))
    print(f"timers:   {armed}/5 armed")
    v = subprocess.run([PY, str(BIN / "kent_audit.py"), "verify"], capture_output=True, text=True)
    print("audit:    " + next((l for l in (v.stdout + v.stderr).splitlines() if not l.startswith("note:")), "?"))
    print("gents:")
    sys.stdout.flush()
    tool("kent_gent.py", "list")
    digests = sorted((Path(c["KENT_DATA"]) / "digests").glob("*.md"))
    print(f"digest:   {digests[-1].name if digests else 'none yet'}")
    unread = len(kentlib.unread_notices(kentlib.kent_db(c), principal(), mark=False, limit=100))
    print(f"notices:  {unread} unread" + (" (kent notices)" if unread else ""))
    return 0


def cmd_ask(args: list[str]) -> int:
    grants, rest = take_grants(args)
    if rest:
        die("usage: ask [--grant FD | --grant-rw FD]... (question on stdin)", 2)
    q = sys.stdin.buffer.read(64 * 1024 + 1)
    if not q.strip():
        die("empty question", 2)
    if len(q) > 64 * 1024:
        die("question longer than 64 KiB", 2)
    f = KHOME / "work" / f"q-{secrets.token_hex(8)}.txt"
    fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as fh:
        fh.write(q)
    try:
        r = subprocess.run([HERMES, *grants, "chat", "-Q", "--oneshot", "--query-file", str(f)],
                           capture_output=True, text=True, pass_fds=grant_fds(grants))
        keep = lambda text: "\n".join(l for l in text.splitlines() if not l.startswith("session_id:")).strip()
        if keep(r.stderr):
            print(keep(r.stderr), file=sys.stderr)
        print(keep(r.stdout))
        return r.returncode
    finally:
        f.unlink(missing_ok=True)


def cmd_new(args: list[str]) -> int:
    if len(args) != 2 or args[0] != "--name" or not re.fullmatch(r"[\w .-]{1,64}", args[1]):
        die("usage: new --name NAME (letters, digits, space, . _ -; max 64)", 2)
    data = sys.stdin.buffer.read(1024 * 1024 + 1)
    if len(data) > 1024 * 1024:
        die("project archive larger than 1 MiB", 2)
    dest = KHOME / "inbox" / principal() / time.strftime("%Y%m%dT%H%M%S")
    dest.mkdir(parents=True, mode=0o700)
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
        members = tar.getmembers()
        if {m.name for m in members} != PROJECT_FILES or not all(m.isreg() and m.size <= 256 * 1024 for m in members):
            die(f"project must contain exactly {sorted(PROJECT_FILES)} as regular files", 2)
        tar.extractall(dest, filter="data")
    return tool("kent_gent.py", "spawn", "--name", args[1], "--project", str(dest))


def cmd_export(args: list[str]) -> int:
    if len(args) != 1:
        die("usage: export ID", 2)
    sid = sid_ok(args[0])
    c = kentlib.conf()
    for base in (Path(c["STACKS_DIR"]), Path(c["GENT_ARCHIVE_DIR"])):
        ws = base / sid / "data" / "workspace"
        if ws.is_dir():
            break
    else:
        die(f"no workspace for Gent {sid}")
    buf = io.BytesIO()
    total = 0
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        for p in sorted(ws.rglob("*")):
            if p.is_file() and not p.is_symlink():
                total += p.stat().st_size
                if total > 200 * 1024 * 1024:
                    die("workspace larger than 200 MiB; publish it to Gitea instead (kent gent assess)")
                info = tar.gettarinfo(str(p), arcname=str(p.relative_to(ws)))
                info.uid = info.gid = 0; info.uname = info.gname = ""; info.mode = 0o644
                with p.open("rb") as fh:
                    tar.addfile(info, fh)
    sys.stdout.buffer.write(buf.getvalue())
    return 0


def cmd_gent(args: list[str]) -> int:
    if len(args) < 2 or args[0] not in GENT_ACTIONS:
        die(f"usage: gent <{'|'.join(GENT_ACTIONS)}> ID [option]", 2)
    action, sid, rest = args[0], sid_ok(args[1]), args[2:]
    allowed = {"logs": ("--tail",), "wait": ("--timeout",), "destroy": ("--purge",)}.get(action, ())
    if rest and (rest[0] not in allowed or (rest[0] != "--purge" and (len(rest) != 2 or not rest[1].isdigit()))):
        die(f"unsupported option for gent {action}: {' '.join(rest)}", 2)
    return tool("kent_gent.py", action, sid, *rest)


def cmd_notices(args: list[str]) -> int:
    """What Kent has to tell this operator about Gents (finished, failed, halted, stuck).
    Unread notices are marked read as they are shown; --all shows the last 20 again."""
    if any(a not in ("--all", "--quiet") for a in args):
        die("usage: notices [--all] [--quiet]", 2)
    kdb = kentlib.kent_db(kentlib.conf())
    if "--all" in args:
        rows = kdb.execute("SELECT * FROM (SELECT * FROM notices ORDER BY id DESC LIMIT 20) ORDER BY id").fetchall()
    else:
        rows = kentlib.unread_notices(kdb, principal())
    if not rows:
        if "--quiet" not in args:
            print("No new notices.")
        return 0
    print(f"Notices from Kent ({len(rows)}):")
    for r in rows:
        print(f"  [{r['created_at']} UTC] " + r["text"].replace("\n", "\n    "))
    return 0


def cmd_digest() -> int:
    digests = sorted((Path(kentlib.conf()["KENT_DATA"]) / "digests").glob("*.md"))
    if not digests:
        print("No digest yet (written daily at 07:00).")
        return 0
    sys.stdout.write(digests[-1].read_text())
    return 0


def main(argv: list[str]) -> int:
    import pwd
    if os.geteuid() != pwd.getpwnam("kent").pw_uid:
        die("kent-exec must run as the kent account (use the kent command)")
    if not argv:
        die("no command", 2)
    cmd, args = argv[0], argv[1:]
    audit("cli", " ".join([cmd] + [a if len(a) < 80 else a[:80] + "…" for a in args])[:300])
    if cmd == "chat":
        grants, rest = take_grants(args)
        if rest:
            die("usage: chat [--grant FD | --grant-rw FD]...", 2)
        close_other_fds(grant_fds(grants))
        os.execv(HERMES, [HERMES, *grants])
    if cmd == "ask":
        return cmd_ask(args)
    simple = {"status": cmd_status, "digest": cmd_digest,
              "audit": lambda: tool("kent_audit.py", "verify"), "gents": lambda: tool("kent_gent.py", "list")}
    if cmd in simple:
        return simple[cmd]()
    if cmd == "new":
        return cmd_new(args)
    if cmd == "export":
        return cmd_export(args)
    if cmd == "notices":
        return cmd_notices(args)
    if cmd == "gent":
        return cmd_gent(args)
    die(f"unknown command {cmd!r}", 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
