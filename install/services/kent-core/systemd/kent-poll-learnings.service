[Unit]
Description=Kent: review Gent learnings and relay escalations
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/kent-core/bin/kent_poll_learnings.py 
User=kent
Group=kent
Environment=KENT_CONF=/etc/kent/kent/kent.conf HOME=/var/lib/kent
WorkingDirectory=/var/lib/kent
UMask=0027
Nice=10
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
# Not NoNewPrivileges/ProtectSystem=strict: the circuit breaker stops stuck Gents through
# the root-owned broker (sudo kent-gent-ctl), which needs setuid execution and /run/sudo.
ProtectSystem=full
