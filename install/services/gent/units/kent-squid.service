[Unit]
Description=Kent Gent egress proxy (Squid, read-only public web)
Documentation=file:///etc/kent/squid/squid.conf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kent-squid
Group=kent-squid
# Own service name (-n) keeps its shared-memory segments apart from any vendor squid;
# segments left in /dev/shm by a crash would make the next start fail, so clear ours.
ExecStartPre=/usr/bin/find /dev/shm -maxdepth 1 -user kent-squid -type f -delete
ExecStartPre=/usr/sbin/squid -n kentsquid -k parse -f /etc/kent/squid/squid.conf
ExecStart=/usr/sbin/squid -N -n kentsquid -f /etc/kent/squid/squid.conf
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=5
StateDirectory=kent-squid
StateDirectoryMode=0750
LogsDirectory=kent-squid
LogsDirectoryMode=0750

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# squid calls setresuid/setgid to its own ids and capset to drop capabilities even when
# unprivileged; harmless here (empty bounding set, NoNewPrivileges)
SystemCallFilter=@setuid capset
UMask=0077

[Install]
WantedBy=multi-user.target
